void setup() {

  pinMode(2, OUTPUT); // Yellow
  pinMode(3, OUTPUT); // Green
  pinMode(4, OUTPUT); // Red
}

void loop() {

  digitalWrite(4, HIGH);
  digitalWrite(3, LOW);
  digitalWrite(2, LOW);
  delay(2000);

  digitalWrite(4, LOW);
  digitalWrite(2, HIGH);
  delay(2000);

  digitalWrite(2, LOW);
  digitalWrite(3, HIGH);
  delay(2000);
}
